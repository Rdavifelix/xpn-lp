# Copy this file to .env and fill in your own values.
# All Expo public env vars must be prefixed with EXPO_PUBLIC_ to be
# available in client code (see src/lib/env.ts).

# --- Supabase --------------------------------------------------------------
# Project Settings -> API in your Supabase dashboard.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY

# --- Weather (Open-Meteo) ---------------------------------------------------
# Open-Meteo's free tier requires no API key. This is only here so the
# provider is swappable later (e.g. OpenWeatherMap) without touching code -
# see src/features/recommendations/weatherProfile.ts.
EXPO_PUBLIC_WEATHER_PROVIDER=open-meteo
# Only needed if you switch EXPO_PUBLIC_WEATHER_PROVIDER to openweathermap.
EXPO_PUBLIC_OPENWEATHERMAP_API_KEY=
