# Configure depois de escolher o domínio. Nunca inclua token na URL.
MCP_PUBLIC_URL=http://127.0.0.1:8081/mcp
MCP_HOST=127.0.0.1
PORT=8081
SUPABASE_URL=https://SEU_PROJETO_REF.supabase.co
# Chave PUBLICÁVEL/anon; o servidor não usa service_role.
SUPABASE_PUBLISHABLE_KEY=
# IDs dos clientes OAuth aprovados, separados por vírgula.
MCP_OAUTH_CLIENT_IDS=

# Habilitar somente com a migration e regras de clientes dinâmicos no banco
MCP_DYNAMIC_CLIENTS=false
